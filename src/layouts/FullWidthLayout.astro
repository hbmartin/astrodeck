---
/**
 * Full Width Layout
 *
 * Layout for showcase pages, portfolios, and galleries that need
 * full viewport width. Includes SEO meta tags.
 */
import type { ImageMetadata } from 'astro';
import PageDocument from '@/components/PageDocument.astro';
import { ui } from '@/config/ui';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AnimationObserver from '@/components/AnimationObserver.astro';

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  /** Exclude the page from search engines (adds robots noindex, nofollow) */
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<PageDocument
  {title}
  {description}
  {image}
  {noindex}
  bodyClass="min-h-screen flex flex-col antialiased"
>
  <a
    href="#main-content"
    data-astro-reload
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] bg-primary text-primary-foreground px-4 py-2 rounded-md font-medium"
  >
    {ui.skipToContent}
  </a>
  <Header variant="fullWidth" />
  <main id="main-content" tabindex="-1" class="flex-1 w-full">
    <slot />
  </main>
  <Footer variant="fullWidth" />
  <AnimationObserver />
</PageDocument>
