---
import RegistryUsage from '@/components/demos/RegistryUsage.astro';
import { groupComponents } from '@/components/demos/section-groups';
import Icon from '@/components/Icon.astro';

const questions = [
  {
    question: 'What is AstroDeck?',
    answer:
      'AstroDeck is a free, open-source starter kit for building websites with a coding agent. It ships typed, data-driven sections, a central site config, a theme script, checks and agent skills, styled with Tailwind CSS v4.',
  },
  {
    question: 'Is AstroDeck free to use?',
    answer:
      'Yes, AstroDeck is completely free and open-source under the MIT license. You can use it for personal and commercial projects without any cost or attribution requirement.',
  },
  {
    question: 'Does AstroDeck support dark mode?',
    answer:
      'Absolutely. Every component is built with CSS variables and Tailwind CSS, so dark mode works out of the box. Just toggle the class on the html element and all sections adapt automatically.',
  },
  {
    question: 'Can I use AstroDeck with an existing Astro project?',
    answer:
      'Yes. You can copy individual components into any Astro project. Make sure you have Tailwind CSS v4 configured via the @tailwindcss/vite plugin and the same CSS custom properties defined in your globals.css.',
  },
];
---

<!-- Testimonials -->
<section id="testimonials" class="scroll-mt-20">
  <div class="mb-8">
    <h2 class="text-3xl font-bold mb-2">Testimonials</h2>
    <p class="text-muted-foreground">Build trust with social proof.</p>
  </div>

  <RegistryUsage names={groupComponents.testimonials} />

  <div class="space-y-12">
    <!-- Testimonial 1: Grid -->
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Grid Layout</h3>
      </div>
      <div class="border-t pt-6">
        <div class="grid md:grid-cols-3 gap-6">
          <div class="rounded-lg border bg-card p-6 space-y-4">
            <p class="text-sm leading-relaxed">
              "Nebula saved us weeks of development time. The components are beautiful and easy to
              customize."
            </p>
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full bg-muted flex items-center justify-center">
                <span class="text-sm font-medium">SC</span>
              </div>
              <div>
                <p class="text-sm font-medium">Sarah Chen</p>
                <p class="text-xs text-muted-foreground">CEO, TechCorp</p>
              </div>
            </div>
          </div>
          <div class="rounded-lg border bg-card p-6 space-y-4">
            <p class="text-sm leading-relaxed">
              "Best Astro boilerplate I've used. Clean code, great documentation, and excellent
              support."
            </p>
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full bg-muted flex items-center justify-center">
                <span class="text-sm font-medium">MJ</span>
              </div>
              <div>
                <p class="text-sm font-medium">Marcus Johnson</p>
                <p class="text-xs text-muted-foreground">Developer</p>
              </div>
            </div>
          </div>
          <div class="rounded-lg border bg-card p-6 space-y-4">
            <p class="text-sm leading-relaxed">
              "The perfect starting point for any SaaS project. Highly recommended for anyone using
              Astro."
            </p>
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full bg-muted flex items-center justify-center">
                <span class="text-sm font-medium">ER</span>
              </div>
              <div>
                <p class="text-sm font-medium">Emily Rodriguez</p>
                <p class="text-xs text-muted-foreground">Product Manager</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Testimonial 2: Featured -->
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Featured Single</h3>
      </div>
      <div class="border-t pt-6">
        <div class="rounded-lg bg-muted/50 p-12 text-center max-w-3xl mx-auto">
          <svg class="h-8 w-8 text-primary mx-auto mb-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
          </svg>
          <p class="text-lg leading-relaxed mb-6">
            Nebula has completely transformed how we build landing pages. The quality of the
            components and attention to detail is exceptional. Our development time has been cut in
            half.
          </p>
          <div class="flex items-center justify-center gap-4">
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="font-medium text-primary">AK</span>
            </div>
            <div class="text-left">
              <p class="font-semibold">Alex Kim</p>
              <p class="text-sm text-muted-foreground">CTO, StartupCo</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Testimonial 3: Scroll -->
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Horizontal Scroll</h3>
      </div>
      <div class="border-t pt-6">
        <div class="flex gap-6 overflow-x-auto pb-4" tabindex="0">
          <div class="min-w-[300px] rounded-lg border bg-card p-6 space-y-4">
            <p class="text-sm">"Game changer for our team!"</p>
            <div class="flex items-center gap-2">
              <div class="h-8 w-8 rounded-full bg-muted flex items-center justify-center text-xs">
                JD
              </div>
              <div class="text-xs">
                <p class="font-medium">Jane Doe</p>
                <p class="text-muted-foreground">Designer</p>
              </div>
            </div>
          </div>
          <div class="min-w-[300px] rounded-lg border bg-card p-6 space-y-4">
            <p class="text-sm">"Excellent components and documentation."</p>
            <div class="flex items-center gap-2">
              <div class="h-8 w-8 rounded-full bg-muted flex items-center justify-center text-xs">
                TP
              </div>
              <div class="text-xs">
                <p class="font-medium">Tom Peters</p>
                <p class="text-muted-foreground">Engineer</p>
              </div>
            </div>
          </div>
          <div class="min-w-[300px] rounded-lg border bg-card p-6 space-y-4">
            <p class="text-sm">"Best boilerplate for Astro projects."</p>
            <div class="flex items-center gap-2">
              <div class="h-8 w-8 rounded-full bg-muted flex items-center justify-center text-xs">
                LW
              </div>
              <div class="text-xs">
                <p class="font-medium">Lisa Wang</p>
                <p class="text-muted-foreground">Founder</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Newsletters -->
<section id="newsletters" class="scroll-mt-20">
  <div class="mb-8">
    <h2 class="text-3xl font-bold mb-2">Newsletter Signups</h2>
    <p class="text-muted-foreground">Capture leads and grow your audience.</p>
  </div>

  <RegistryUsage names={groupComponents.newsletters} />

  <div class="space-y-12">
    <!-- Newsletter 1: Inline -->
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Simple Inline</h3>
      </div>
      <div class="border-t pt-6">
        <div class="rounded-lg border bg-muted/50 p-8 max-w-2xl mx-auto">
          <div class="text-center mb-6">
            <h3 class="text-xl font-bold mb-2">Subscribe to our newsletter</h3>
            <p class="text-sm text-muted-foreground">
              Get the latest updates delivered to your inbox.
            </p>
          </div>
          <div class="flex gap-2">
            <input
              type="email"
              placeholder="Enter your email"
              class="flex-1 min-w-0 h-10 rounded-md border px-3 text-sm"
            />
            <button class="px-6 h-10 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90">
              Subscribe
            </button>
          </div>
          <p class="text-xs text-muted-foreground text-center mt-4">
            We respect your privacy. Unsubscribe at any time.
          </p>
        </div>
      </div>
    </div>

    <!-- Newsletter 2: Split -->
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Split with Visual</h3>
      </div>
      <div class="border-t pt-6">
        <div class="rounded-lg border overflow-hidden grid md:grid-cols-2">
          <div class="bg-primary/10 p-12 flex items-center justify-center">
            <div class="text-center">
              <div class="text-6xl mb-4">📧</div>
              <p class="font-semibold">Stay Updated</p>
            </div>
          </div>
          <div class="p-12 flex flex-col justify-center">
            <h3 class="text-2xl font-bold mb-2">Join our newsletter</h3>
            <p class="text-muted-foreground mb-6">Weekly insights on building better products.</p>
            <div class="space-y-3">
              <input
                type="email"
                placeholder="Your email address"
                class="w-full h-10 rounded-md border px-3 text-sm"
              />
              <button class="w-full h-10 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:bg-primary/90">
                Get Started
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Newsletter 3: Bar -->
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Bottom Bar</h3>
      </div>
      <div class="border-t pt-6">
        <div class="border-t bg-muted/30 p-6">
          <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <div>
              <h4 class="font-semibold mb-1">Get product updates</h4>
              <p class="text-sm text-muted-foreground">Join 10,000+ subscribers</p>
            </div>
            <div class="flex gap-2 w-full md:w-auto">
              <input
                type="email"
                placeholder="you@example.com"
                class="flex-1 md:w-64 h-9 rounded-md border px-3 text-sm"
              />
              <button class="px-4 h-9 bg-foreground text-background rounded-md text-sm font-medium hover:bg-foreground/90 whitespace-nowrap">
                Sign Up
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="scroll-mt-20">
  <div class="mb-8">
    <h2 class="text-3xl font-bold mb-2">FAQ</h2>
    <p class="text-muted-foreground">Answer common questions with an accessible accordion.</p>
  </div>

  <RegistryUsage names={groupComponents.faq} />

  <div class="space-y-12">
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Default Accordion</h3>
      </div>
      <div class="border-t pt-6">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-10">
            <h2 class="text-3xl font-bold mb-3">Frequently Asked Questions</h2>
            <p class="text-muted-foreground">Everything you need to know about AstroDeck</p>
          </div>
          <div class="divide-y divide-border border-y border-border">
            {questions.map(({ question, answer }) => (
              <details class="group" name="faq-demo">
                <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 font-medium text-foreground hover:text-muted-foreground transition-colors">
                  <span>{question}</span>
                  <Icon
                    name="plus"
                    size={20}
                    class="shrink-0 text-muted-foreground transition-transform duration-300 group-open:rotate-45"
                  />
                </summary>
                <p class="pb-5 text-sm text-muted-foreground leading-relaxed">{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats -->
<section id="stats" class="scroll-mt-20">
  <div class="mb-8">
    <h2 class="text-3xl font-bold mb-2">Stats</h2>
    <p class="text-muted-foreground">Highlight key metrics that build credibility.</p>
  </div>

  <RegistryUsage names={groupComponents.stats} />

  <div class="space-y-12">
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Four-Column Grid</h3>
      </div>
      <div class="border-t pt-6">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold mb-3">Nebula in numbers</h2>
          <p class="text-muted-foreground">Numbers that speak for themselves</p>
        </div>
        <dl class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-border border-y">
          <div class="flex flex-col items-center text-center px-6 py-8">
            <dt class="order-2 mt-2 text-sm font-semibold">Teams</dt>
            <dd class="order-1 text-4xl font-bold tracking-tight">12K+</dd>
            <dd class="order-3 mt-1 text-sm text-muted-foreground">Across 80+ countries</dd>
          </div>
          <div class="flex flex-col items-center text-center px-6 py-8">
            <dt class="order-2 mt-2 text-sm font-semibold">Projects created</dt>
            <dd class="order-1 text-4xl font-bold tracking-tight">2M+</dd>
            <dd class="order-3 mt-1 text-sm text-muted-foreground">And growing every week</dd>
          </div>
          <div class="flex flex-col items-center text-center px-6 py-8">
            <dt class="order-2 mt-2 text-sm font-semibold">Integrations</dt>
            <dd class="order-1 text-4xl font-bold tracking-tight">40+</dd>
            <dd class="order-3 mt-1 text-sm text-muted-foreground">
              With the tools you already use
            </dd>
          </div>
          <div class="flex flex-col items-center text-center px-6 py-8">
            <dt class="order-2 mt-2 text-sm font-semibold">Uptime</dt>
            <dd class="order-1 text-4xl font-bold tracking-tight">99.9%</dd>
            <dd class="order-3 mt-1 text-sm text-muted-foreground">Battle-tested infrastructure</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<!-- Team -->
<section id="team" class="scroll-mt-20">
  <div class="mb-8">
    <h2 class="text-3xl font-bold mb-2">Team</h2>
    <p class="text-muted-foreground">Introduce the people behind your product.</p>
  </div>

  <RegistryUsage names={groupComponents.team} />

  <div class="space-y-12">
    <div class="border rounded-lg p-8 bg-card">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold">Card Grid with Initials</h3>
      </div>
      <div class="border-t pt-6">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold mb-3">Meet Our Team</h2>
          <p class="text-muted-foreground">The people building Nebula</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="flex flex-col items-center text-center rounded-xl border bg-card p-6 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
            <div class="h-20 w-20 rounded-full bg-muted flex items-center justify-center ring-2 ring-border mb-4">
              <span class="text-xl font-semibold text-muted-foreground">AR</span>
            </div>
            <p class="font-semibold text-base leading-tight">Alex Rivera</p>
            <p class="text-sm text-muted-foreground mt-1">Co-Founder & CEO</p>
            <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
              Passionate about developer experience and open source.
            </p>
            <div class="flex items-center gap-3 mt-4 pt-4 border-t border-border w-full justify-center">
              <span class="text-muted-foreground" aria-hidden="true">
                <Icon name="github" filled class="h-4 w-4" />
              </span>
              <span class="text-muted-foreground" aria-hidden="true">
                <Icon name="x" filled class="h-4 w-4" />
              </span>
            </div>
          </div>
          <div class="flex flex-col items-center text-center rounded-xl border bg-card p-6 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
            <div class="h-20 w-20 rounded-full bg-muted flex items-center justify-center ring-2 ring-border mb-4">
              <span class="text-xl font-semibold text-muted-foreground">SC</span>
            </div>
            <p class="font-semibold text-base leading-tight">Sam Chen</p>
            <p class="text-sm text-muted-foreground mt-1">Lead Engineer</p>
            <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
              TypeScript enthusiast and Astro core contributor.
            </p>
            <div class="flex items-center gap-3 mt-4 pt-4 border-t border-border w-full justify-center">
              <span class="text-muted-foreground" aria-hidden="true">
                <Icon name="github" filled class="h-4 w-4" />
              </span>
              <span class="text-muted-foreground" aria-hidden="true">
                <Icon name="linkedin" filled class="h-4 w-4" />
              </span>
            </div>
          </div>
          <div class="flex flex-col items-center text-center rounded-xl border bg-card p-6 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
            <div class="h-20 w-20 rounded-full bg-muted flex items-center justify-center ring-2 ring-border mb-4">
              <span class="text-xl font-semibold text-muted-foreground">JL</span>
            </div>
            <p class="font-semibold text-base leading-tight">Jordan Lee</p>
            <p class="text-sm text-muted-foreground mt-1">Design Lead</p>
            <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
              Crafting accessible interfaces with Tailwind and shadcn/ui.
            </p>
            <div class="flex items-center gap-3 mt-4 pt-4 border-t border-border w-full justify-center">
              <span class="text-muted-foreground" aria-hidden="true">
                <Icon name="x" filled class="h-4 w-4" />
              </span>
              <span class="text-muted-foreground" aria-hidden="true">
                <Icon name="linkedin" filled class="h-4 w-4" />
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
