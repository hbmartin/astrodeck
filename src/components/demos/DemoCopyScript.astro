<script>
  import { createDemoCopyToggle } from '@/components/demos/demo-copy-toggle';
  import { copyText } from '@/lib/clipboard';

  const toggleCode = createDemoCopyToggle(copyText, {
    setTimeout: (callback, delay) => window.setTimeout(callback, delay),
    clearTimeout: (timer) => window.clearTimeout(timer),
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('button.copy-btn[data-code]');
    if (!button) return;
    const panel = document.getElementById(`code-${button.dataset.code}`);
    if (panel) void toggleCode(button, panel);
  });
</script>
