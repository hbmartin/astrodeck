{
  "name": "astrodeck",
  "type": "module",
  "version": "4.0.1",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node -e \"require('node:fs').copyFileSync('dist/sitemap-index.xml','dist/sitemap.xml')\"",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "node scripts/format.mjs",
    "format:check": "oxfmt --check .",
    "lint:docs": "node scripts/lint-docs.mjs",
    "check:fallow": "node scripts/check-fallow.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lint:design": "node scripts/lint-design.mjs",
    "theme": "node scripts/theme.mjs",
    "icons": "node scripts/icons.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "starter:clean": "node scripts/starter-clean.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:vibe2prod": "node scripts/sync-vibe2prod.mjs",
    "setup:audit": "node scripts/setup-audit.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "validate": "node scripts/verify.mjs --skip-build",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.4",
    "@vercel/analytics": "^1.6.1",
    "astro": "^7.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^15.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "0.5.3",
    "@playwright/test": "1.65.1",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "culori": "^4.0.2",
    "fallow": "3.43.1",
    "node-html-parser": "^9.0.7",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3"
  }
}
