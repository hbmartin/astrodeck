---
import ShowcaseBuildingBlocks from '@/components/demos/ShowcaseBuildingBlocks.astro';
import ShowcasePricing from '@/components/demos/ShowcasePricing.astro';
import ShowcaseSocialProof from '@/components/demos/ShowcaseSocialProof.astro';
import ShowcaseComparison from '@/components/demos/ShowcaseComparison.astro';
import ShowcaseContact from '@/components/demos/ShowcaseContact.astro';
import DemoCopyScript from '@/components/demos/DemoCopyScript.astro';
import DemoNavigation from '@/components/demos/DemoNavigation.astro';
import FullWidthLayout from '@/layouts/FullWidthLayout.astro';
import registry from '@/registry.json';
import { groupComponents } from '@/components/demos/section-groups';

// Sidebar entries; the count is the number of registry components shown in each group.
const sections = [
  { id: 'heroes', label: 'Heroes' },
  { id: 'features', label: 'Features' },
  { id: 'content', label: 'Content' },
  { id: 'logos', label: 'Logo Clouds' },
  { id: 'integrations', label: 'Integrations' },
  { id: 'ctas', label: 'CTAs' },
  { id: 'pricing', label: 'Pricing' },
  { id: 'testimonials', label: 'Testimonials' },
  { id: 'newsletters', label: 'Newsletters' },
  { id: 'faq', label: 'FAQ' },
  { id: 'stats', label: 'Stats' },
  { id: 'team', label: 'Team' },
  { id: 'comparison', label: 'Comparison' },
  { id: 'contact', label: 'Contact' },
];

// Registry components per showcase group; RegistryUsage renders their usage from src/registry.json.

const navSections = sections.map((section) => ({
  ...section,
  count: groupComponents[section.id].length,
}));

// Every registry section must appear in a group (fails the build otherwise).
const grouped = Object.values(groupComponents).flat();
const missing = registry.sections.map((s) => s.name).filter((n) => !grouped.includes(n));
if (missing.length) throw new Error(`sections.astro: no group for ${missing.join(', ')}`);
---

<FullWidthLayout
  title="Sections"
  description="AstroDeck section library: registry usage snippets for every section and layout ideas built with the same design tokens."
>
  <style>
    html {
      scroll-behavior: smooth;
    }
    :global(.nav-link:not(.bg-foreground):hover) {
      background-color: var(--color-muted);
    }
    :global(.nav-link.bg-foreground:hover) {
      opacity: 0.9;
    }
  </style>
  <div class="min-h-screen">
    <!-- Header -->
    <div class="py-16 px-6 md:px-12">
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl mb-4">Section Library</h1>
      <p class="text-lg text-muted-foreground max-w-3xl">
        Sections for your pages, each with the usage snippet from the registry. Your coding agent
        composes pages from them with props. Names, quotes and numbers in the previews are fictional
        sample content.
      </p>
    </div>

    <DemoNavigation
      items={navSections}
      navId="sections-nav"
      linkClass="flex items-center justify-between py-2 rounded-md"
      label="Section navigation"
      mobile
    />

    <!-- Main Content with Sidebar -->
    <div class="lg:flex lg:gap-10 py-12 px-6 md:px-12">
      <DemoNavigation
        items={navSections}
        navId="sections-nav"
        linkClass="flex items-center justify-between py-2 rounded-md"
        label="Section navigation"
        heading="Sections"
      />

      <!-- Sections Content -->
      <div class="flex-1 min-w-0 space-y-16">
        <ShowcaseBuildingBlocks />
        <ShowcasePricing />
        <ShowcaseSocialProof />
        <ShowcaseComparison />
        <ShowcaseContact />
      </div>
    </div>
  </div>

  <DemoCopyScript />
</FullWidthLayout>
