---
import ContactInfoItem from '@/components/ContactInfoItem.astro';
import { ui } from '@/config/ui';

interface Props {
  title?: string;
  subtitle?: string;
  /** Heading tag for the title. Use 'h1' when the section is the page's main heading. */
  headingLevel?: 'h1' | 'h2';
  email?: string;
  phone?: string;
  address?: string;
  /** Link to the address on a map service, e.g. an OpenStreetMap or Google Maps search URL. */
  mapUrl?: string;
  /** Opening hours, one row per day range, e.g. { days: 'Mon–Fri', time: '9:00–17:00' }. */
  hours?: { days: string; time: string }[];
  /** Renders the contact form. Omit to show contact info only (no form). */
  form?: { action: string; method?: 'get' | 'post'; submitLabel?: string };
}

const {
  title = 'Get in Touch',
  subtitle,
  headingLevel: Heading = 'h2',
  email,
  phone,
  address,
  mapUrl,
  hours = [],
  form,
} = Astro.props;

const hasContactInfo = email || phone || address || hours.length > 0;
// tel: URIs must not contain spaces ("0511 000000" is invalid HTML); keep digits and a leading +.
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
---

<section class="py-16 md:py-24 px-6">
  <div class="container max-w-5xl mx-auto">
    <div class:list={['grid gap-12 lg:gap-16 items-start', form ? 'md:grid-cols-2' : 'max-w-2xl']}>
      <!-- Left column: info -->
      <div>
        <Heading class="text-3xl font-bold leading-tight md:text-4xl">{title}</Heading>
        {subtitle && <p class="mt-4 text-muted-foreground text-lg leading-relaxed">{subtitle}</p>}

        {hasContactInfo && (
          <ul class="mt-8 space-y-5" aria-label={ui.contact.list}>
            {email && (
              <ContactInfoItem icon="mail" label={ui.contact.email}>
                <a
                  href={`mailto:${email}`}
                  class="text-sm text-foreground hover:text-primary transition-colors"
                >
                  {email}
                </a>
              </ContactInfoItem>
            )}

            {phone && (
              <ContactInfoItem icon="phone" label={ui.contact.phone}>
                <a
                  href={telHref}
                  class="text-sm text-foreground hover:text-primary transition-colors"
                >
                  {phone}
                </a>
              </ContactInfoItem>
            )}

            {address && (
              <ContactInfoItem icon="map-pin" label={ui.contact.address}>
                <address class="text-sm text-foreground not-italic whitespace-pre-line">
                  {address}
                </address>
                {mapUrl && (
                  <a
                    href={mapUrl}
                    class="inline-block py-1 text-sm text-primary hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {ui.contact.map}
                  </a>
                )}
              </ContactInfoItem>
            )}

            {hours.length > 0 && (
              <ContactInfoItem icon="clock" label={ui.contact.hours}>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm text-foreground">
                  {hours.map((row) => (
                    <div class="contents">
                      <dt>{row.days}</dt>
                      <dd>{row.time}</dd>
                    </div>
                  ))}
                </dl>
              </ContactInfoItem>
            )}
          </ul>
        )}
      </div>

      <!-- Right column: form -->
      {form && (
        <div class="rounded-lg border bg-card p-6 md:p-8">
          <form action={form.action} method={form.method ?? 'post'}>
            <div class="space-y-5">
              {/* Name */}
              <div class="space-y-1.5">
                <label for="contact-name" class="text-sm font-medium leading-none">
                  {ui.contact.name}{' '}
                  <span class="text-destructive" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="contact-name"
                  type="text"
                  name="name"
                  required
                  autocomplete="name"
                  class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                />
              </div>

              {/* Email */}
              <div class="space-y-1.5">
                <label for="contact-email" class="text-sm font-medium leading-none">
                  {ui.contact.email}{' '}
                  <span class="text-destructive" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="contact-email"
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                />
              </div>

              {/* Subject */}
              <div class="space-y-1.5">
                <label for="contact-subject" class="text-sm font-medium leading-none">
                  {ui.contact.subject}
                </label>
                <input
                  id="contact-subject"
                  type="text"
                  name="subject"
                  autocomplete="off"
                  class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                />
              </div>

              {/* Message */}
              <div class="space-y-1.5">
                <label for="contact-message" class="text-sm font-medium leading-none">
                  {ui.contact.message}{' '}
                  <span class="text-destructive" aria-hidden="true">
                    *
                  </span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="5"
                  class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-y min-h-[120px] supports-[field-sizing:content]:field-sizing-content supports-[field-sizing:content]:overflow-y-auto"
                />
              </div>

              {/* Required field note */}
              <p class="text-xs text-muted-foreground">
                <span class="text-destructive" aria-hidden="true">
                  *
                </span>{' '}
                {ui.contact.required}
              </p>

              {/* Submit */}
              <button
                type="submit"
                class="inline-flex w-full items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
              >
                {form.submitLabel ?? ui.contact.submit}
              </button>
            </div>
          </form>
        </div>
      )}
    </div>
  </div>
</section>
