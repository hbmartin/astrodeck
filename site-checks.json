{
  "pages": [
    { "path": "/", "file": "index.html", "indexable": true },
    { "path": "/404/", "file": "404.html", "indexable": false }
  ],
  "responses": [
    {
      "path": "/",
      "status": 200,
      "headerIncludes": { "content-type": "text/html" },
      "bodyIncludes": "id=\"main-content\""
    },
    {
      "path": "/starter-smoke-missing/",
      "status": 404,
      "headerIncludes": { "content-type": "text/html" },
      "bodyIncludes": "data-not-found-home"
    }
  ]
}
