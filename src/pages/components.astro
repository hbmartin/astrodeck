---
import DemoCopyScript from '@/components/demos/DemoCopyScript.astro';
import DemoNavigation from '@/components/demos/DemoNavigation.astro';
import FullWidthLayout from '@/layouts/FullWidthLayout.astro';
import registry from '@/registry.json';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  CardFooter,
} from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import {
  DialogDemo,
  AccordionDemo,
  TabsDemo,
  TooltipDemo,
  SelectDemo,
  DropdownMenuDemo,
} from '@/components/demos/ComponentDemos';

const components = [
  { id: 'button', label: 'Button' },
  { id: 'badge', label: 'Badge' },
  { id: 'card', label: 'Card' },
  { id: 'input', label: 'Input & Label' },
  { id: 'dialog', label: 'Dialog' },
  { id: 'accordion', label: 'Accordion' },
  { id: 'tabs', label: 'Tabs' },
  { id: 'tooltip', label: 'Tooltip' },
  { id: 'select', label: 'Select' },
  { id: 'dropdown', label: 'Dropdown Menu' },
];

// Code snippets come from src/registry.json (single source of truth).
const snippetUi: Record<string, string> = {
  button: 'Button',
  badge: 'Badge',
  card: 'Card',
  input: 'Input',
  dialog: 'Dialog',
  accordion: 'Accordion',
  tabs: 'Tabs',
  tooltip: 'Tooltip',
  select: 'Select',
  dropdown: 'DropdownMenu',
};
const codeSnippets = Object.fromEntries(
  Object.entries(snippetUi).map(([key, name]) => {
    const entry = registry.ui.find((u) => u.name === name);
    if (!entry) throw new Error(`registry.json has no ui component "${name}"`);
    return [key, entry.example];
  })
) as Record<string, string>;
---

<FullWidthLayout
  title="Components"
  description="AstroDeck UI components: buttons, cards, dialogs, tabs and more, built with shadcn/ui, Radix UI and Tailwind CSS. Usage snippets come from the registry."
>
  <!-- Header -->
  <div class="py-16 px-6 md:px-12">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl mb-4">Component Library</h1>
    <p class="text-lg text-muted-foreground max-w-3xl">
      {registry.ui.length} UI components built with{' '}
      <a
        href="https://ui.shadcn.com"
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-foreground"
      >
        shadcn/ui
      </a>
      , Radix UI primitives, and Tailwind CSS. Fully accessible, dark mode ready, and customizable.
    </p>
  </div>

  <DemoNavigation
    items={components}
    navId="components-nav"
    linkClass="block py-2 rounded-md"
    label="Component navigation"
    mobile
  />

  <!-- Main Content with Sidebar -->
  <div class="lg:flex lg:gap-10 py-12 px-6 md:px-12">
    <DemoNavigation
      items={components}
      navId="components-nav"
      linkClass="block py-2 rounded-md"
      label="Component navigation"
      heading="Components"
    />

    <!-- Component Content -->
    <div class="flex-1 min-w-0 space-y-16">
      <!-- Button -->
      <section id="button" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Button</h2>
          <p class="text-muted-foreground mt-1">
            6 variants, 4 sizes. Supports{' '}
            <code class="text-sm bg-muted px-1.5 py-0.5 rounded">asChild</code> for custom elements.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">All Variants</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="button"
              aria-expanded="false"
              aria-controls="code-button"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-button">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.button}</code></pre>
          </div>
          <div class="border-t pt-6 space-y-4">
            <div class="flex flex-wrap gap-3 items-center">
              <Button client:load>Default</Button>
              <Button client:load variant="secondary">
                {'Secondary'}
              </Button>
              <Button client:load variant="outline">
                {'Outline'}
              </Button>
              <Button client:load variant="ghost">
                {'Ghost'}
              </Button>
              <Button client:load variant="destructive">
                {'Destructive'}
              </Button>
              <Button client:load variant="link">
                {'Link'}
              </Button>
            </div>
            <div class="flex flex-wrap gap-3 items-center">
              <Button client:load size="sm">
                {'Small'}
              </Button>
              <Button client:load size="default">
                {'Default'}
              </Button>
              <Button client:load size="lg">
                {'Large'}
              </Button>
              <Button client:load size="icon" aria-label="Next">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </Button>
            </div>
          </div>
        </div>
      </section>

      <!-- Badge -->
      <section id="badge" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Badge</h2>
          <p class="text-muted-foreground mt-1">
            Pill-shaped labels for status, tags, or categories.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">All Variants</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="badge"
              aria-expanded="false"
              aria-controls="code-badge"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-badge">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.badge}</code></pre>
          </div>
          <div class="border-t pt-6 flex flex-wrap gap-3 items-center">
            <Badge client:load>Default</Badge>
            <Badge client:load variant="secondary">
              {'Secondary'}
            </Badge>
            <Badge client:load variant="outline">
              {'Outline'}
            </Badge>
            <Badge client:load variant="destructive">
              {'Destructive'}
            </Badge>
          </div>
        </div>
      </section>

      <!-- Card -->
      <section id="card" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Card</h2>
          <p class="text-muted-foreground mt-1">
            Compound component with Header, Title, Description, Content, and Footer.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Card with Actions</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="card"
              aria-expanded="false"
              aria-controls="code-card"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-card">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.card}</code></pre>
          </div>
          <div class="border-t pt-6">
            <div class="max-w-sm">
              <Card client:load>
                <CardHeader>
                  <CardTitle>Project Settings</CardTitle>
                  <CardDescription>
                    {'Manage your project configuration and preferences.'}
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <p class="text-sm text-muted-foreground">
                    Update your project name, description, and visibility settings.
                  </p>
                </CardContent>
                <CardFooter className="flex justify-between">
                  <Button variant="outline">Cancel</Button>
                  <Button>Save</Button>
                </CardFooter>
              </Card>
            </div>
          </div>
        </div>
      </section>

      <!-- Input & Label -->
      <section id="input" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Input & Label</h2>
          <p class="text-muted-foreground mt-1">
            Form input field with associated label. Supports all HTML input types.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Form Fields</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="input"
              aria-expanded="false"
              aria-controls="code-input"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-input">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.input}</code></pre>
          </div>
          <div class="border-t pt-6 max-w-sm space-y-4">
            <div class="space-y-2">
              <Label client:load htmlFor="demo-email">
                {'Email'}
              </Label>
              <Input client:load type="email" id="demo-email" placeholder="you@example.com" />
            </div>
            <div class="space-y-2">
              <Label client:load htmlFor="demo-pw">
                {'Password'}
              </Label>
              <Input client:load type="password" id="demo-pw" placeholder="Enter password" />
            </div>
            <div class="space-y-2">
              <Label client:load htmlFor="demo-dis">
                {'Disabled'}
              </Label>
              <Input client:load id="demo-dis" placeholder="Can't type here" disabled />
            </div>
          </div>
        </div>
      </section>

      <!-- Dialog -->
      <section id="dialog" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Dialog</h2>
          <p class="text-muted-foreground mt-1">
            Modal overlay with backdrop blur. Traps focus and closes on escape.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Modal Dialog</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="dialog"
              aria-expanded="false"
              aria-controls="code-dialog"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-dialog">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.dialog}</code></pre>
          </div>
          <div class="border-t pt-6">
            <DialogDemo client:load />
          </div>
        </div>
      </section>

      <!-- Accordion -->
      <section id="accordion" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Accordion</h2>
          <p class="text-muted-foreground mt-1">
            Collapsible content with smooth height animation. Single or multiple mode.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Collapsible Accordion</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="accordion"
              aria-expanded="false"
              aria-controls="code-accordion"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-accordion">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.accordion}</code></pre>
          </div>
          <div class="border-t pt-6">
            <AccordionDemo client:load />
          </div>
        </div>
      </section>

      <!-- Tabs -->
      <section id="tabs" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Tabs</h2>
          <p class="text-muted-foreground mt-1">Pill-style tab navigation with keyboard support.</p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Tab Navigation</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="tabs"
              aria-expanded="false"
              aria-controls="code-tabs"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-tabs">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.tabs}</code></pre>
          </div>
          <div class="border-t pt-6">
            <TabsDemo client:load />
          </div>
        </div>
      </section>

      <!-- Tooltip -->
      <section id="tooltip" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Tooltip</h2>
          <p class="text-muted-foreground mt-1">
            Small popup on hover with positioning and delay support.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Hover Tooltip</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="tooltip"
              aria-expanded="false"
              aria-controls="code-tooltip"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-tooltip">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.tooltip}</code></pre>
          </div>
          <div class="border-t pt-6">
            <TooltipDemo client:load />
          </div>
        </div>
      </section>

      <!-- Select -->
      <section id="select" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Select</h2>
          <p class="text-muted-foreground mt-1">
            Styled dropdown select with groups, labels, and check icon.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Select Dropdown</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="select"
              aria-expanded="false"
              aria-controls="code-select"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-select">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.select}</code></pre>
          </div>
          <div class="border-t pt-6">
            <SelectDemo client:load />
          </div>
        </div>
      </section>

      <!-- Dropdown Menu -->
      <section id="dropdown" class="scroll-mt-20">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Dropdown Menu</h2>
          <p class="text-muted-foreground mt-1">
            Positioned menu with items, labels, separators, and keyboard navigation.
          </p>
        </div>
        <div class="border rounded-lg p-8 bg-card">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold">Action Menu</h3>
            <button
              class="copy-btn text-sm px-3 py-1 border rounded-md hover:bg-muted transition-colors"
              data-code="dropdown"
              aria-expanded="false"
              aria-controls="code-dropdown"
            >
              Copy Code
            </button>
          </div>
          <div class="code-block" hidden id="code-dropdown">
            <pre
              tabindex="0"
              class="mb-6 p-4 bg-muted rounded-md overflow-x-auto text-sm"
            ><code>{codeSnippets.dropdown}</code></pre>
          </div>
          <div class="border-t pt-6">
            <DropdownMenuDemo client:load />
          </div>
        </div>
      </section>
    </div>
  </div>

  <DemoCopyScript />
</FullWidthLayout>
