---
import Icon from '@/components/Icon.astro';
import DemoNavLinks from '@/components/demos/DemoNavLinks.astro';

interface Props {
  items: { id: string; label: string; count?: number }[];
  navId: string;
  label: string;
  heading?: string;
  linkClass: string;
  mobile?: boolean;
}

const { items, navId, label, heading, linkClass, mobile = false } = Astro.props;
---

{mobile ? (
  <div class="sticky top-14 z-30 lg:hidden border-b border-t bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 px-6 md:px-12">
    <button
      type="button"
      id="mobile-subnav-toggle"
      class="flex items-center justify-between w-full py-3 text-sm"
      aria-expanded="false"
      aria-controls="mobile-subnav-menu"
    >
      <span class="flex items-center gap-2 text-muted-foreground">
        <span>On this page:</span>
        <span id="mobile-subnav-current" class="font-medium text-foreground">
          {items[0]?.label}
        </span>
      </span>
      <span id="mobile-subnav-chevron" class="transition-transform duration-200">
        <Icon name="chevron-down" class="h-4 w-4 text-muted-foreground" />
      </span>
    </button>
    <nav id="mobile-subnav-menu" class="hidden pb-3 space-y-1" aria-label={label}>
      <DemoNavLinks {items} {linkClass} />
    </nav>
  </div>
) : (
  <aside class="hidden lg:block lg:w-48 lg:shrink-0">
    <div class="sticky top-20">
      <nav id={navId} class="space-y-1" aria-label={label}>
        <p class="text-sm font-semibold mb-4 text-muted-foreground" aria-hidden="true">
          {heading}
        </p>
        <DemoNavLinks {items} {linkClass} />
      </nav>
    </div>
  </aside>
)}

<script>
  import { initDemoNavigation } from '@/components/demos/demo-navigation';
  initDemoNavigation();
  document.addEventListener('astro:page-load', initDemoNavigation);
</script>
