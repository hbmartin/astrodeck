---
import DemoExternalLink from '@/components/demos/DemoExternalLink.astro';
import DemoNavigation from '@/components/demos/DemoNavigation.astro';
import FullWidthLayout from '@/layouts/FullWidthLayout.astro';
import DocsOnboarding from '@/components/demos/DocsOnboarding.astro';
import DocsBuilding from '@/components/demos/DocsBuilding.astro';
import DocsVerification from '@/components/demos/DocsVerification.astro';
import DocsReference from '@/components/demos/DocsReference.astro';

const sections = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'workflow', label: 'Build-Site Workflow' },
  { id: 'brief', label: 'Brief & PROJECT.md' },
  { id: 'site-config', label: 'Site Config' },
  { id: 'theme', label: 'Theme & Branding' },
  { id: 'building-blocks', label: 'Sections & Pages' },
  { id: 'cleanup', label: 'Demo Cleanup' },
  { id: 'verify', label: 'Verify' },
  { id: 'vibe2prod', label: 'vibe2prod Audit' },
  { id: 'agents', label: 'Supported Agents' },
  { id: 'mcp', label: 'MCP Servers' },
  { id: 'deploy', label: 'Build & Deploy' },
  { id: 'astro-7', label: 'Astro 7 Notes' },
  { id: 'migrating', label: 'Migrating from 3.x' },
  { id: 'multilingual', label: 'Multilingual Sites' },
  { id: 'project-structure', label: 'Project Structure' },
];
---

<style>
  :global(.nav-link:not(.bg-foreground):hover) {
    background-color: var(--color-muted);
  }
  :global(.nav-link.bg-foreground:hover) {
    opacity: 0.9;
  }
</style>

<FullWidthLayout
  title="Documentation"
  description="AstroDeck 4.0 docs: build-site workflow, brief, site config, theme, cleanup, verify, vibe2prod, supported agents and migrating from 3.x."
>
  <!-- Header -->
  <div class="py-16 px-6 md:px-12">
    <h1 class="text-4xl font-bold tracking-tight md:text-6xl mb-4">Documentation</h1>
    <p class="text-lg text-muted-foreground max-w-3xl">
      Open AstroDeck in your coding agent and describe your site; the agent follows the workflow
      below. Everything it runs, you can run yourself.
    </p>
  </div>

  <DemoNavigation
    items={sections}
    navId="docs-nav"
    linkClass="block py-2.5 rounded-xl"
    label="Page navigation"
    mobile
  />

  <!-- Main Content with Sidebar -->
  <div class="lg:flex lg:gap-10 py-12 px-6 md:px-12">
    <DemoNavigation
      items={sections}
      navId="docs-nav"
      linkClass="block py-2.5 rounded-xl"
      label="Documentation sections"
      heading="Guide"
    />

    <!-- Docs Content -->
    <div class="flex-1 min-w-0 space-y-20">
      <DocsOnboarding />
      <DocsBuilding />
      <DocsVerification />
      <DocsReference />
    </div>
  </div>

  <!-- Footer CTA -->
  <div class="py-16 px-6 md:px-12 text-center">
    <p class="text-muted-foreground mb-4">
      Source code, README, issues and releases are on GitHub.
    </p>
    <DemoExternalLink
      href="https://github.com/holger1411/astrodeck"
      label="View on GitHub"
      class="rounded-xl"
    />
  </div>
</FullWidthLayout>
