---
/**
 * Minimal Layout
 *
 * Full-width layout without header or footer.
 * Ideal for standalone pages like 404, maintenance, or landing pages
 * that need complete control over the viewport.
 *
 * @example
 * ```astro
 * <MinimalLayout title="Page Not Found">
 *   <div class="flex items-center justify-center min-h-screen">
 *     <h1>404</h1>
 *   </div>
 * </MinimalLayout>
 * ```
 */
import PageDocument from '@/components/PageDocument.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<PageDocument {title} {description} {image} {noindex} bodyClass="min-h-screen antialiased">
  <main id="main-content" class="min-h-screen">
    <slot />
  </main>
</PageDocument>
