---
import { site } from '@/config/site';
import { navigationState } from '@/lib/navigation';

interface Props {
  mobile?: boolean;
}
const { mobile = false } = Astro.props;

const base = mobile
  ? 'block px-3 py-2 rounded-md text-base font-medium transition-colors'
  : 'inline-block py-2 transition-colors';
const current = mobile ? 'bg-accent text-accent-foreground' : 'text-foreground font-medium';
const inactive = mobile
  ? 'hover:bg-accent hover:text-accent-foreground'
  : 'text-foreground/60 hover:text-foreground/80';
---

{site.nav.map(({ href, label }) => {
  const { active, exact } = navigationState(href, Astro.url);
  return (
    <a
      href={href}
      class:list={[base, active ? current : inactive]}
      aria-current={exact ? 'page' : undefined}
    >
      {label}
    </a>
  );
})}
