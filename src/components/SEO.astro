---
/**
 * SEO Head Component
 *
 * Provides comprehensive SEO meta tags including:
 * - Basic meta tags (title, description)
 * - Canonical URL
 * - Open Graph tags for social sharing
 * - Twitter Card tags
 * - Sitemap and RSS links
 *
 * @example
 * ```astro
 * <SEO
 *   title="Page Title"
 *   description="Page description for SEO"
 *   image="/images/og-image.png"
 *   type="website"
 * />
 * ```
 */
import { site } from '@/config/site';

import { resolveSocialImage, type SocialImage } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string | SocialImage;
  type?: 'website' | 'article';
  publishedTime?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  author = site.author,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const canonicalURL = new URL(siteUrl.origin);
canonicalURL.pathname = Astro.url.pathname;
const defaultImage = site.ogImage
  ? { path: site.ogImage, alt: title, width: 1200, height: 630 }
  : '';
const socialImage = resolveSocialImage(image ?? defaultImage, siteUrl, title);

const siteName = site.name;

// JSON-LD: BlogPosting for articles, WebSite for everything else
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        ...(socialImage && { image: socialImage.url.href }),
        url: canonicalURL.toString(),
        ...(publishedTime && { datePublished: publishedTime.toISOString() }),
        author: { '@type': 'Person', name: author },
        publisher: { '@type': 'Organization', name: siteName, url: siteUrl.toString() },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: siteUrl.toString(),
        description,
      };
---

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Browser UI theming (light and dark, matching the background color tokens) -->
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#030303" />

<!-- Structured data -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
/>
<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImage && (
  <>
    <meta property="og:image" content={socialImage.url.href} />
    {socialImage.width && <meta property="og:image:width" content={String(socialImage.width)} />}
    {socialImage.height && <meta property="og:image:height" content={String(socialImage.height)} />}
    <meta property="og:image:alt" content={socialImage.alt} />
  </>
)}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={site.locale} />

{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime.toISOString()} />
    <meta property="article:author" content={author} />
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && (
  <>
    <meta name="twitter:image" content={socialImage.url.href} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
  </>
)}

<!-- Sitemap & RSS -->
<link rel="sitemap" href="/sitemap-index.xml" />
{site.features.blog && site.features.rss && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${site.name} Blog RSS Feed`}
    href="/rss.xml"
  />
)}
