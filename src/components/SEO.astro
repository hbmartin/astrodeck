---
/**
 * SEO Head Component
 *
 * Provides comprehensive SEO meta tags including:
 * - Basic meta tags (title, description)
 * - Canonical URL
 * - Open Graph tags for social sharing
 * - Twitter Card tags
 * - Sitemap and RSS links
 *
 * @example
 * ```astro
 * <SEO
 *   title="Page Title"
 *   description="Page description for SEO"
 *   image="/images/og-image.png"
 *   type="website"
 * />
 * ```
 */
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';
import { jsonLd } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  /** A public path, or an imported image (its real width and height are announced) */
  image?: string | ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = site.ogImage,
  type = 'website',
  publishedTime,
  author = site.author,
  noindex = false,
} = Astro.props;

// Fallback for dev server when Astro.site might be undefined
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const imagePath = typeof image === 'string' ? image : image?.src;
const socialImageURL = imagePath ? new URL(imagePath, siteUrl) : undefined;
// Only an imported image has known dimensions; a wrong size is worse than none.
const socialImageSize = typeof image === 'object' ? image : undefined;

const siteName = site.name;

// JSON-LD: BlogPosting for articles, WebSite for everything else
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        ...(socialImageURL && { image: socialImageURL.toString() }),
        url: canonicalURL.toString(),
        ...(publishedTime && { datePublished: publishedTime.toISOString() }),
        author: { '@type': 'Person', name: author },
        publisher: { '@type': 'Organization', name: siteName, url: siteUrl.toString() },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: siteUrl.toString(),
        description,
      };
---

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Browser UI theming (light and dark, matching the background color tokens) -->
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#030303" />

<!-- Structured data -->
<script is:inline type="application/ld+json" set:html={jsonLd(structuredData)} />
<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImageURL && (
  <>
    <meta property="og:image" content={socialImageURL} />
    {socialImageSize && (
      <>
        <meta property="og:image:width" content={String(socialImageSize.width)} />
        <meta property="og:image:height" content={String(socialImageSize.height)} />
      </>
    )}
    <meta property="og:image:alt" content={title} />
  </>
)}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={site.locale} />

{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime.toISOString()} />
    <meta property="article:author" content={author} />
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImageURL && (
  <>
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={title} />
  </>
)}

<!-- Sitemap & RSS -->
<link rel="sitemap" href="/sitemap-index.xml" />
{site.features.blog && site.features.rss && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${site.name} Blog RSS Feed`}
    href="/rss.xml"
  />
)}
