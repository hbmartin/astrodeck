---
import MockWindowDots from '@/components/MockWindowDots.astro';
import HeroActions from '@/components/HeroActions.astro';
/**
 * HeroSplit Section Component
 *
 * A split-layout hero with text on the left and a visual element on the right.
 * Designed for product landing pages — distinct from the centered Hero.
 *
 * @example
 * ```astro
 * <HeroSplit
 *   title="Ship your product faster"
 *   subtitle="Pre-built components that just work."
 *   tagline="Now in Beta"
 *   primaryCta={{ href: "/sections", label: "Browse Components" }}
 *   secondaryCta={{ href: "https://github.com/hbmartin/astrodeck", label: "GitHub" }}
 * />
 * ```
 *
 * @customization
 * - Pass `image` prop to replace the decorative mock-up with a real image
 * - Omit `tagline` to hide the badge above the title
 * - Adjust CTA buttons via primaryCta / secondaryCta props
 */
interface Props {
  title: string;
  subtitle: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  tagline?: string;
  image?: { src: string; alt: string };
}

const { title, subtitle, primaryCta, secondaryCta, tagline, image } = Astro.props;
---

<section class="min-h-[70vh] flex items-center py-16 md:py-24 px-6 overflow-hidden">
  <div class="container max-w-6xl mx-auto grid md:grid-cols-2 gap-12 md:gap-16 items-center">
    {/* Left column: text content */}
    <div class="flex flex-col gap-6" data-animate="slide-left">
      {/* Tagline pill */}
      {tagline && (
        <div class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-muted px-4 py-1.5 text-sm font-medium text-muted-foreground">
          <span
            class="inline-block h-2 w-2 rounded-full bg-primary opacity-80"
            aria-hidden="true"
          />
          {tagline}
        </div>
      )}

      {/* Title */}
      <h1 class="text-5xl font-bold leading-tight tracking-tight text-balance md:text-6xl">
        {title}
      </h1>

      {/* Subtitle */}
      <p class="text-lg text-muted-foreground md:text-xl max-w-lg" set:html={subtitle} />

      {/* CTA buttons */}
      {(primaryCta || secondaryCta) && (
        <HeroActions
          {primaryCta}
          {secondaryCta}
          primaryPadding="px-10"
          secondaryPadding="px-8"
          class="mt-2"
        />
      )}
    </div>

    {/* Right column: image or decorative mock-up */}
    <div data-animate="slide-right" data-delay="2">
      {image ? (
        /* Real image */
        <img
          src={image.src}
          alt={image.alt}
          class="w-full rounded-2xl shadow-2xl shadow-foreground/10 border border-border object-cover"
          loading="eager"
          decoding="async"
        />
      ) : (
        /* Abstract decorative dashboard mock-up */
        <div
          class="relative w-full rounded-2xl bg-muted border border-border p-6 shadow-2xl shadow-foreground/10"
          aria-hidden="true"
        >
          {/* Mock-up top bar */}
          <div class="flex items-center gap-2 mb-5">
            <span class="h-3 w-3 rounded-full bg-border" />
            <span class="h-3 w-3 rounded-full bg-border" />
            <span class="h-3 w-3 rounded-full bg-border" />
            <span class="ml-3 flex-1 h-5 rounded bg-border/60 max-w-[140px]" />
          </div>

          {/* Stacked window cards */}
          <div class="flex flex-col gap-4">
            {/* Window card 1: primary, full width */}
            <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
              {/* Fake title bar */}
              <MockWindowDots gap="gap-1.5" />
              {/* Code-like lines */}
              <div class="flex flex-col gap-2">
                <div class="flex gap-2">
                  <span class="h-3 w-12 rounded bg-primary/20" />
                  <span class="h-3 w-24 rounded bg-muted-foreground/20" />
                  <span class="h-3 w-10 rounded bg-primary/30" />
                </div>
                <div class="flex gap-2 pl-4">
                  <span class="h-3 w-8 rounded bg-muted-foreground/15" />
                  <span class="h-3 w-32 rounded bg-muted-foreground/20" />
                </div>
                <div class="flex gap-2 pl-4">
                  <span class="h-3 w-16 rounded bg-primary/20" />
                  <span class="h-3 w-20 rounded bg-muted-foreground/20" />
                </div>
                <div class="flex gap-2">
                  <span class="h-3 w-6 rounded bg-muted-foreground/15" />
                </div>
              </div>
            </div>

            {/* Two smaller cards side by side */}
            <div class="grid grid-cols-2 gap-4">
              {/* Window card 2 */}
              <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
                <MockWindowDots gap="gap-1" />
                {/* Content placeholders */}
                <div class="flex flex-col gap-2">
                  <span class="h-3 w-full rounded bg-muted-foreground/20" />
                  <span class="h-3 w-3/4 rounded bg-muted-foreground/15" />
                  <span class="h-3 w-5/6 rounded bg-primary/15" />
                  <span class="h-3 w-2/3 rounded bg-muted-foreground/20" />
                </div>
              </div>

              {/* Window card 3 */}
              <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
                <MockWindowDots gap="gap-1" />
                {/* Content placeholders with a "stat" look */}
                <div class="flex flex-col gap-2">
                  <span class="h-6 w-16 rounded bg-primary/20 mb-1" />
                  <span class="h-2.5 w-full rounded bg-muted-foreground/15" />
                  <span class="h-2.5 w-4/5 rounded bg-muted-foreground/20" />
                  <span class="h-2.5 w-3/5 rounded bg-muted-foreground/15" />
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
