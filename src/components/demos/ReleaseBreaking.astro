---
import CodeBlock from '@/components/demos/CodeBlock.astro';
import { inline } from '@/components/demos/release-text';

interface Props {
  items: string[];
  title?: string;
  migration?: { title: string; before: string; after: string; lang?: string }[];
}

const { items, title = 'Breaking Changes', migration } = Astro.props;
---

<div class="mb-4 rounded-lg border border-destructive/30 bg-destructive/5 p-4">
  <p class="text-sm font-semibold text-foreground mb-2">{title}</p>
  <ul class="space-y-1">
    {items.map((item) => (
      <li class="text-sm text-muted-foreground flex items-start gap-2">
        <span class="text-foreground mt-0.5 shrink-0" aria-hidden="true">
          !
        </span>
        <span set:html={inline(item)} />
      </li>
    ))}
  </ul>
  {migration && (
    <details class="mt-4">
      <summary class="cursor-pointer text-sm font-medium text-foreground">
        Before / after snippets
      </summary>
      <div class="mt-3 space-y-4">
        {migration.map((m) => (
          <div>
            <p class="text-sm font-semibold mb-1">{m.title}</p>
            <p class="text-xs text-muted-foreground mb-1">Before (3.x)</p>
            <CodeBlock
              class="bg-background border border-border rounded-md p-3 overflow-x-auto"
              codeClass={`text-xs font-mono language-${m.lang ?? 'astro'}`}
              code={m.before}
            />
            <p class="text-xs text-muted-foreground mt-2 mb-1">After (4.0)</p>
            <CodeBlock
              class="bg-background border border-border rounded-md p-3 overflow-x-auto"
              codeClass={`text-xs font-mono language-${m.lang ?? 'astro'}`}
              code={m.after}
            />
          </div>
        ))}
      </div>
    </details>
  )}
</div>
