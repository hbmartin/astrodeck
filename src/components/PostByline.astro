---
import { formatDate } from '@/lib/blog';

interface Props {
  date: Date;
  author: string;
  readingTime?: string;
  class?: string;
}
const { date, author, readingTime, class: className } = Astro.props;
---

<div class:list={['flex items-center gap-4 text-sm text-muted-foreground', className]}>
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  <span>•</span>
  <span>{author}</span>
  {readingTime && (
    <>
      <span>•</span>
      <span>{readingTime}</span>
    </>
  )}
</div>
