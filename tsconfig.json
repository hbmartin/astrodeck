{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "starter", "tests/fixtures", "brief", ".agents", ".claude/skills"],
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
